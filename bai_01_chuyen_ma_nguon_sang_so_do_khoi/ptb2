#include<stdio.h>
#include<math.h>
int main(){
	float a,b,c,x1,x2;
	scanf("%f%f%f",&a,&b,&c);
	if(a!= 0){
		float delta = b * b - 4 * a * c;
		if(delta < 0)printf("VN");
		else if(delta == 0){
			x1 = -b/(2 * a);
			printf("%.3f",x1);
		}
		else{
			x1 = (-b - sqrt(delta)) / ( 2 * a);
			x2 = (-b + sqrt(delta)) / ( 2 * a);
			if(x1 > x2){
				float t = x1;
				x1 = x2;
				x2 = t;
			}
				printf("%.3f %.3f",x1,x2);
		}
	}
	else{
		if(b != 0){
			x1 = -c/b;
			printf("%.3f",x1);
		}
		else if(c == 0)printf("VSN");
		else printf("VN");
	}

	return 0;
}
